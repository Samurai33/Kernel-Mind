{
  "name": "kernelmind",
  "version": "1.0.0",
  "description": "Neuroscience-informed ambient music designed to optimize coding performance for developers",
  "main": "src/index.js",
  "type": "module",
  "keywords": [
    "music",
    "binaural-beats",
    "productivity",
    "coding",
    "developers",
    "neuroscience",
    "ambient",
    "focus",
    "concentration",
    "programming",
    "ide-extension",
    "vscode",
    "jetbrains"
  ],
  "author": {
    "name": "KernelMind Project",
    "email": "hello@kernelmind.audio",
    "url": "https://kernelmind.audio"
  },
  "license": "MIT",
  "homepage": "https://kernelmind.audio",
  "repository": {
    "type": "git",
    "url": "https://github.com/KernelMind/KernelMind.git"
  },
  "bugs": {
    "url": "https://github.com/KernelMind/KernelMind/issues",
    "email": "support@kernelmind.audio"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/KernelMind"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:web": "npm run build && npm run build:pwa",
    "build:electron": "electron-builder",
    "build:mobile": "capacitor build",
    "preview": "vite preview",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:ui": "vitest --ui",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx,.vue",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:serve": "vitepress serve docs",
    "audio:validate": "node scripts/validate-audio.js",
    "audio:process": "node scripts/process-audio.js",
    "binaural:generate": "node scripts/generate-binaural.js",
    "security:scan": "npm audit && snyk test",
    "markdown:check": "markdownlint-cli2 \"**/*.md\" \"!node_modules\"",
    "prepare": "husky install",
    "release": "standard-version",
    "release:dry": "standard-version --dry-run"
  },
  "dependencies": {
    "@capacitor/app": "^5.0.0",
    "@capacitor/core": "^5.0.0",
    "@capacitor/haptics": "^5.0.0",
    "@capacitor/keyboard": "^5.0.0",
    "@capacitor/status-bar": "^5.0.0",
    "@vueuse/core": "^10.0.0",
    "pinia": "^2.1.0",
    "tone": "^14.7.77",
    "vue": "^3.3.0",
    "vue-router": "^4.2.0",
    "workbox-window": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^5.0.0",
    "@eslint/js": "^9.0.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-vue": "^4.0.0",
    "@vitest/coverage-v8": "^1.0.0",
    "@vitest/ui": "^1.0.0",
    "@vue/eslint-config-prettier": "^8.0.0",
    "@vue/eslint-config-typescript": "^12.0.0",
    "electron": "^27.0.0",
    "electron-builder": "^24.0.0",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.0.0",
    "globals": "^13.20.0",
    "husky": "^8.0.0",
    "jsdom": "^23.0.0",
    "lint-staged": "^15.0.0",
    "markdownlint-cli2": "^0.10.0",
    "prettier": "^3.0.0",
    "snyk": "^1.1200.0",
    "standard-version": "^9.5.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vite-plugin-pwa": "^0.17.0",
    "vitepress": "^1.0.0",
    "vitest": "^1.0.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,scss,less,html,json,md}": [
      "prettier --write"
    ],
    "*.md": [
      "markdownlint-cli2 --fix"
    ]
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ],
  "peerDependencies": {
    "@types/web": "^0.0.99"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.0.0"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "standard-version": {
    "types": [
      {
        "type": "feat",
        "section": "Features"
      },
      {
        "type": "fix",
        "section": "Bug Fixes"
      },
      {
        "type": "music",
        "section": "Music & Audio"
      },
      {
        "type": "docs",
        "section": "Documentation"
      },
      {
        "type": "perf",
        "section": "Performance"
      },
      {
        "type": "test",
        "section": "Testing"
      }
    ]
  },
  "capacitor": {
    "appId": "audio.kernelmind.app",
    "appName": "KernelMind",
    "webDir": "dist",
    "server": {
      "androidScheme": "https"
    }
  },
  "build": {
    "appId": "audio.kernelmind.desktop",
    "productName": "KernelMind",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/**/*"
    ],
    "mac": {
      "category": "public.app-category.music",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "AudioVideo"
    }
  }
}